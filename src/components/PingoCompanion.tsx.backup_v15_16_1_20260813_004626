function normalizeText(value: string) {
  return value.replace(/\s+/g, " ").trim()
}

function classText(el: HTMLElement) {
  return typeof el.className === "string" ? el.className.toLowerCase() : ""
}

function hasCardHint(el: HTMLElement) {
  const cls = classText(el)
  return (
    el.tagName === "ARTICLE" ||
    CARD_HINTS.some((hint) => cls.includes(hint)) ||
    el.getAttribute("role") === "article"
  )
}

function ownLabel(el: HTMLElement) {
  const aria = el.getAttribute("aria-label")
  const title = el.getAttribute("title")
  if (aria) return normalizeText(aria)
  if (title) return normalizeText(title)

  const heading = el.querySelector<HTMLElement>("h1,h2,h3,h4,h5,h6")
  if (heading) return normalizeText(heading.innerText)

  if (el.matches("button,a")) {
    const clone = el.cloneNode(true) as HTMLElement
    clone.querySelectorAll("svg,img,small,kbd").forEach((node) => node.remove())
    return normalizeText(clone.innerText).slice(0, 120)
  }

  return normalizeText(el.innerText).slice(0, 120)
}

function firstSummary(el: HTMLElement) {
  const paragraph = el.querySelector<HTMLElement>("p")
  if (paragraph) return normalizeText(paragraph.innerText).slice(0, 280)

  const text = normalizeText(el.innerText)
  return text.slice(0, 280)
}

function findSemanticTarget(source: HTMLElement | null): HTMLElement | null {
  if (!source || source.closest(".pingo-ui")) return null

  let node: HTMLElement | null = source
  let fallbackInteractive: HTMLElement | null = null
  let depth = 0

  while (node && node !== document.body && depth < 9) {
    if (!fallbackInteractive && node.matches("button,a[href],input,select,textarea,[role='button']")) {
      fallbackInteractive = node
    }

    if (hasCardHint(node)) return node

    if (node.matches("[role='dialog'],dialog")) return node

    node = node.parentElement
    depth += 1
  }

  if (fallbackInteractive) return fallbackInteractive

  const heading = source.closest("h1,h2,h3,h4,h5,h6") as HTMLElement | null
  if (heading) return heading

  const section = source.closest("section") as HTMLElement | null
  if (section) return section

  return null
}

function buildContext(element: HTMLElement): TargetContext {
  let kind: TargetKind = "other"

  if (hasCardHint(element)) {
    kind = classText(element).includes("news") ? "news" : "card"
  } else if (element.matches("button,[role='button']")) {
    kind = "button"
  } else if (element.matches("a[href]")) {
    kind = "link"
  } else if (element.matches("input,select,textarea")) {
    kind = "input"
  } else if (element.matches("section")) {
    kind = "section"
  } else if (element.matches("h1,h2,h3,h4,h5,h6")) {
    kind = "heading"
  }

  const section = element.closest("section")
  const sectionHeading = section?.querySelector<HTMLElement>("h1,h2,h3")
  const metaNodes = Array.from(element.querySelectorAll<HTMLElement>("small,strong,span"))
    .map((node) => normalizeText(node.innerText))
    .filter((value) => value && value.length < 90)
    .slice(0, 4)

  const label = ownLabel(element) || "Elemento del Campus"
  const summary = firstSummary(element)
  const sectionTitle = sectionHeading ? normalizeText(sectionHeading.innerText) : ""
  const href = element.matches("a[href]") ? element.getAttribute("href") ?? "" : ""
  const text = normalizeText(`${label} ${summary} ${sectionTitle} ${element.innerText}`).slice(0, 1800)

  return {
    element,
    kind,
    label,
    summary,
    sectionTitle,
    meta: metaNodes.join(" · "),
    href,
    text,
  }
}

function matchingDomain(text: string) {
  return domainLessons.find((item) => item.match.test(text))
}

function buildLesson(context: TargetContext): TutorLesson {
  const text = context.text
  const domain = matchingDomain(text)

  const stageMatch = text.match(/\bS(?:0|[1-9]|1\d)\b/i)
  const standardMatch = text.match(/\b(CS2023|CC2020|CSEC2017|DS2021|OpenFING|FAMAF)\b/i)

  if (context.kind === "button") {
    const lower = text.toLowerCase()

    let actionMeaning = `Este control ejecuta “${context.label}”.`
    if (lower.includes("buscar")) {
      actionMeaning = "Este botón abre la búsqueda global del Campus para localizar etapas, materias, maestrías y profesiones."
    } else if (lower.includes("roadmap")) {
      actionMeaning = "Este botón te lleva al roadmap, donde importa el orden de aprendizaje y no solo la cantidad de temas."
    } else if (lower.includes("campus")) {
      actionMeaning = "Este botón te lleva a la zona de estudio del Campus y a la ruta académica."
    } else if (lower.includes("noticia anterior")) {
      actionMeaning = "Este botón muestra la noticia anterior de este carrusel."
    } else if (lower.includes("noticia siguiente")) {
      actionMeaning = "Este botón muestra la siguiente noticia de este carrusel."
    } else if (lower.includes("ir a noticia")) {
      actionMeaning = "Este punto selecciona directamente una noticia concreta del carrusel."
    }

    return {
      eyebrow: "PINGO · INTERFAZ",
      title: context.label || "Botón",
      what: actionMeaning,
      why: "Pingo identifica primero la función del control para que no tengas que probar botones a ciegas.",
      study: "Si el control cambia de sección, observa qué información aparece y cómo se conecta con tu ruta de estudio.",
      action: "Puedes activarlo cuando quieras. Si prefieres, mantén el cursor aquí y revisa esta explicación antes de hacer clic.",
      tone: "lime",
    }
  }

  if (context.kind === "input") {
    return {
      eyebrow: "PINGO · HERRAMIENTA",
      title: context.label || "Campo de entrada",
      what: "Este campo sirve para introducir información o una búsqueda dentro del Campus.",
      why: "Una consulta específica reduce ruido y te ayuda a encontrar exactamente la materia, profesión o ruta que necesitas.",
      study: "Escribe términos concretos: por ejemplo “sistemas operativos”, “IA”, “ciberseguridad” o una profesión.",
      action: "Prueba con el concepto que quieres dominar y compara los resultados antes de elegir una ruta.",
      tone: "blue",
    }
  }

  if (context.kind === "news") {
    return {
      eyebrow: "PINGO · LECTURA CRÍTICA",
      title: context.label || "Noticia tecnológica",
      what: context.summary
        ? `Esta tarjeta presenta: ${context.summary}`
        : "Esta tarjeta forma parte del radar de noticias tecnológicas del Campus.",
      why: "Una noticia sirve para detectar cambios recientes, pero no reemplaza documentación oficial, estándares ni conocimiento fundamental.",
      study: "Separa hechos de interpretación: revisa fuente, fecha, producto o tecnología afectada, evidencia y consecuencias reales.",
      action: "Después de leerla, responde: ¿qué cambió?, ¿qué fundamento sigue igual? y ¿debo actualizar algo de mi roadmap?",
      tone: "sand",
    }
  }

  if (standardMatch) {
    const standard = standardMatch[1]
    return {
      eyebrow: "PINGO · AUDITORÍA",
      title: context.label || standard,
      what: context.summary || `${standard} funciona como referencia para contrastar la cobertura académica del Campus.`,
      why: "Usar estándares y mallas de referencia reduce el riesgo de construir un roadmap basado solo en opiniones o en una única universidad.",
      study: "No necesitas memorizar el estándar. Úsalo como lista de control: áreas, competencias, profundidad y vacíos de cobertura.",
      action: "Compara esta referencia con las etapas y materias del Campus y detecta qué competencia valida.",
      tone: domain?.tone ?? "lime",
    }
  }

  if (stageMatch && context.kind === "card") {
    const stage = stageMatch[0].toUpperCase()
    return {
      eyebrow: `PINGO · ETAPA ${stage}`,
      title: context.label.replace(new RegExp(`^${stage}\\s*[·:-]?\\s*`, "i"), "") || context.label,
      what: context.summary || `Esta es la etapa ${stage} del roadmap y agrupa competencias que deben trabajarse de forma integrada.`,
      why: domain?.why ?? "Esta etapa existe porque el roadmap intenta construir dependencias en orden: fundamentos antes de especialización y evidencia antes de dar una competencia por dominada.",
      study: domain?.study ?? "Lee el objetivo de la etapa, identifica sus materias y estudia primero los prerrequisitos. Después alterna teoría, ejercicios, laboratorio y proyecto.",
      action: domain?.action ?? "Antes de marcarla como completada, produce una evidencia: solución explicada, laboratorio reproducible, código, examen o proyecto.",
      tone: domain?.tone ?? "green",
