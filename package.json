{
  "name": "Campus_Maestro_V11_Studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "covers:v36": "tsx scripts/build-resource-covers-v36.ts",
    "certifications:update": "tsx scripts/update-certifications-v1.ts",
    "certifications:covers": "tsx scripts/build-certification-covers-v1.ts",
    "certifications:refresh": "npm run certifications:update && npm run certifications:covers",
    "android:assets": "node scripts/generate-android-assets.mjs",
    "app:sync": "npm run build && npx cap sync android",
    "app:open": "npx cap open android",
    "app:run": "npm run build && npx cap run android"
  },
  "dependencies": {
