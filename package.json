    "@react-three/fiber": "^9.7.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4",
    "@types/three": "^0.185.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "elkjs": "0.12.0",
    "graphology": "0.26.0",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
