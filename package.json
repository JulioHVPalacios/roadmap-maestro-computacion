    "lucide-react": "^1.31.0",
    "monaco-editor": "0.55.1",
    "motion": "^13.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.17.0",
    "sigma": "3.0.3",
